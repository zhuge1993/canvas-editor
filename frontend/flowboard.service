[Unit]
Description=FlowBoard ARMv7 drawing server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=flowboard
Group=flowboard
WorkingDirectory=/opt/flowboard
EnvironmentFile=-/opt/flowboard/flowboard.env
Environment=FLOWBOARD_RUNTIME_DIR=/opt/flowboard
ExecStart=/bin/sh /opt/flowboard/start-server.sh
Restart=always
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/flowboard
MemoryMax=1200M
TasksMax=256
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
