[Unit]
Description=FlowBoard editor server
After=network.target

[Service]
Type=simple
User=flowboard
Group=flowboard
WorkingDirectory=/opt/flowboard
EnvironmentFile=-/opt/flowboard/flowboard.env
Environment=FLOWBOARD_RUNTIME_DIR=/opt/flowboard
ExecStart=/usr/bin/env bash /opt/flowboard/start-server.sh
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
