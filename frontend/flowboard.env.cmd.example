@echo off
rem Copy this file to flowboard.env.cmd and fill in your SMTP settings.
set "FLOWBOARD_SMTP_HOST=smtp.qq.com"
set "FLOWBOARD_SMTP_PORT=465"
set "FLOWBOARD_SMTP_SECURE=true"
set "FLOWBOARD_SMTP_USER=your-mail@qq.com"
set "FLOWBOARD_SMTP_PASS=your-qq-authorization-code"
set "FLOWBOARD_SMTP_FROM=your-mail@qq.com"
rem For an HTTPS reverse proxy, optionally set:
rem set "FLOWBOARD_PUBLIC_PROTOCOL=https"
rem 分享链接/对外地址默认自动检测局域网 IP；有公网域名或反代时手动指定：
rem set "FLOWBOARD_PUBLIC_HOST=192.168.1.100"
