#!/sbin/openrc-run

name="FlowBoard"
description="FlowBoard ARMv7 drawing server"
supervisor="supervise-daemon"
command="/opt/flowboard/start-server.sh"
command_user="flowboard:flowboard"
directory="/opt/flowboard"
no_new_privs=yes
umask=0027
respawn_delay=3
respawn_max=0
retry="TERM/15/KILL/5"
healthcheck_delay=30
healthcheck_timer=30

depend() {
  # The local server must start even when the access point is unavailable.
  need localmount
  after firewall
}

healthcheck() {
  /usr/bin/node /opt/flowboard/healthcheck.cjs
}

start_pre() {
  # Program directory stays root-owned; only runtime data directories are writable by the service user.
  checkpath --directory --owner root:flowboard --mode 0750 /opt/flowboard
  checkpath --directory --owner flowboard:flowboard --mode 0750 /opt/flowboard/project-data
  checkpath --directory --owner flowboard:flowboard --mode 0750 /opt/flowboard/auth-data
  checkpath --directory --owner flowboard:flowboard --mode 0750 /opt/flowboard/logs
}
