#!/sbin/openrc-run

name="FlowBoard"
description="FlowBoard ARMv7 drawing server"
supervisor="supervise-daemon"
command="/opt/flowboard/start-server.sh"
command_user="flowboard:flowboard"
directory="/opt/flowboard"
respawn_delay=3
respawn_max=0

depend() {
  need net
  after firewall
}

start_pre() {
  checkpath --directory --owner flowboard:flowboard --mode 0750 /opt/flowboard
  checkpath --directory --owner flowboard:flowboard --mode 0750 /opt/flowboard/project-data
  checkpath --directory --owner flowboard:flowboard --mode 0750 /opt/flowboard/auth-data
  checkpath --directory --owner flowboard:flowboard --mode 0750 /opt/flowboard/logs
}
