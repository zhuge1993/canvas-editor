# FlowBoard Linux runtime settings
FLOWBOARD_HOST=127.0.0.1
FLOWBOARD_PORT=3000
FLOWBOARD_PUBLIC_PROTOCOL=https
FLOWBOARD_COOKIE_SECURE=true

# Authentication email delivery. Set SMTP values before production use.
FLOWBOARD_EMAIL_MODE=smtp
FLOWBOARD_SMTP_HOST=smtp.qq.com
FLOWBOARD_SMTP_PORT=465
FLOWBOARD_SMTP_SECURE=true
FLOWBOARD_SMTP_USER=your-mail@qq.com
FLOWBOARD_SMTP_PASS=your-authorization-code
FLOWBOARD_SMTP_FROM=your-mail@qq.com
