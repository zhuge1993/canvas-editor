# FlowBoard Linux runtime settings (Debian 13 / ARMv7 armhf)
# Keep 127.0.0.1 when exposing FlowBoard through a tunnel/reverse proxy.
FLOWBOARD_HOST=127.0.0.1
FLOWBOARD_PORT=3000
FLOWBOARD_PUBLIC_PROTOCOL=https
FLOWBOARD_COOKIE_SECURE=true

# Redmi Note 4G has only 2 GB RAM. Keep the Node heap bounded.
NODE_OPTIONS=--max-old-space-size=768

# Account policy
FLOWBOARD_DEFAULT_ADMIN_EMAIL=804559340@qq.com
FLOWBOARD_MAX_USERS=20

# Registration verification mail.
# The QQ account/from address default to 804559340@qq.com in the application.
# Configure only the QQ SMTP authorization code with:
#   node server-bundle.cjs set stp YOUR_AUTHORIZATION_CODE
FLOWBOARD_EMAIL_MODE=smtp
FLOWBOARD_SMTP_HOST=smtp.qq.com
FLOWBOARD_SMTP_PORT=465
FLOWBOARD_SMTP_SECURE=true
FLOWBOARD_SMTP_USER=804559340@qq.com
FLOWBOARD_SMTP_PASS=
FLOWBOARD_SMTP_FROM=804559340@qq.com
