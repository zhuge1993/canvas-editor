+/* The Dior shim allocates GEM objects in ION and exports their dma-buf. */
+static void *kgsl_bo_map(struct fd_bo *bo)
+{
+	struct drm_kgsl_gem_get_ion_fd req = {
+		.handle = bo->handle,
+		.ion_fd = -1,
+	};
+	void *map;
+	int ret, saved_errno;
+
+	ret = bo_alloc(to_kgsl_bo(bo));
+	if (ret)
+		return NULL;
+
+	ret = drmCommandWriteRead(bo->dev->fd, DRM_KGSL_GEM_GET_ION_FD,
+			&req, sizeof(req));
+	if (ret || req.ion_fd < 0) {
+		ERROR_MSG("Dior GEM ION export failed: %s", strerror(errno));
+		return NULL;
+	}
+
+	map = drm_mmap(NULL, bo->size, PROT_READ | PROT_WRITE, MAP_SHARED,
+			req.ion_fd, 0);
+	saved_errno = errno;
+	close(req.ion_fd);
+	if (map == MAP_FAILED) {
+		errno = saved_errno;
+		ERROR_MSG("Dior GEM ION mmap failed: %s", strerror(errno));
+		return NULL;
+	}
+	return map;
+}
