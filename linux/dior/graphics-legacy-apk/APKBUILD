# Isolated legacy KGSL/Freedreno userspace for the frozen Dior 3.4 kernel.
pkgname=dior-graphics
pkgver=17.3.9
pkgrel=0
pkgdesc="Isolated Dior Adreno 305 legacy GLES compatibility and rendering probe"
url="https://docs.mesa3d.org/drivers/freedreno.html"
arch="armv7"
license="MIT AND LGPL-2.1-or-later"
options="!strip !pmb:crossdirect"
depends="musl libgcc libstdc++ zlib python3"
makedepends="build-base pkgconf zlib-dev bison flex libatomic_ops-dev"
source="
	https://archive.mesa3d.org/older-versions/17.x/mesa-17.3.9.tar.xz
	https://dri.freedesktop.org/libdrm/libdrm-2.4.89.tar.bz2
	https://www.python.org/ftp/python/2.7.18/Python-2.7.18.tar.xz
	https://files.pythonhosted.org/packages/source/M/Mako/Mako-0.9.1.tar.gz
	https://files.pythonhosted.org/packages/source/M/MarkupSafe/MarkupSafe-1.1.1.tar.gz
	0001-libdrm-dior-kgsl-compat.patch
	test-kgsl-abi.c
	test-kgsl-map.c
	test-kgsl-timestamps.c
	kernel-kgsl-drm-uapi.h
	dior-gles-check
	dior-gles-probe.py
"
builddir="$srcdir/mesa-17.3.9"
_prefix=/opt/dior-graphics
_stage="$srcdir/compat-stage"

prepare() {
    patch -d "$srcdir/libdrm-2.4.89" -p1 -i "$srcdir/0001-libdrm-dior-kgsl-compat.patch"
}

build() {
    # pmbootstrap QEMU_ONLY executes this build and checks inside armv7 musl.
    # Python 2 is a source generator only; it is never installed on the phone.
    cd "$srcdir/Python-2.7.18"
    CFLAGS="$CFLAGS -std=gnu89 -Wno-error=implicit-function-declaration -Wno-error=incompatible-pointer-types" \
        ./configure --prefix="$srcdir/build-python" --disable-shared --without-ensurepip
    make -j2

    cd "$srcdir/libdrm-2.4.89"
    CFLAGS="$CFLAGS -Wno-error=implicit-function-declaration -Wno-error=incompatible-pointer-types" \
        ./configure --prefix="$_prefix" --disable-static \
        --enable-freedreno --enable-freedreno-kgsl --disable-intel \
        --disable-radeon --disable-amdgpu --disable-nouveau \
        --disable-omap-experimental-api --disable-exynos-experimental-api \
        --disable-tegra-experimental-api --disable-vc4 --disable-etnaviv-experimental-api \
        --disable-libkms --disable-udev --disable-valgrind --disable-cairo-tests --disable-manpages
    make -j2
    make DESTDIR="$_stage" install

    cd "$builddir"
    export PYTHON2="$srcdir/Python-2.7.18/python"
    export PYTHONPATH="$srcdir/Mako-0.9.1:$srcdir/MarkupSafe-1.1.1/src"
    export PKG_CONFIG_PATH="$_stage$_prefix/lib/pkgconfig"
    export PKG_CONFIG_SYSROOT_DIR="$_stage"
    CFLAGS="$CFLAGS -Wno-error=implicit-function-declaration -Wno-error=incompatible-pointer-types" \
    CXXFLAGS="$CXXFLAGS -std=gnu++11" \
        ./configure --prefix="$_prefix" --libdir="$_prefix/lib" \
        --with-dri-driverdir="$_prefix/lib/dri" \
        --with-gallium-drivers=freedreno --with-dri-drivers= \
        --with-egl-platforms=drm,surfaceless --enable-egl --enable-gbm \
        --enable-dri --disable-dri3 --enable-gles2 --disable-gles1 \
        --disable-opengl --enable-shared-glapi --disable-glx --disable-glx-tls \
        --disable-llvm --disable-gallium-llvm --disable-libunwind --disable-selinux \
        --disable-osmesa --disable-gallium-osmesa --disable-xa --disable-xvmc \
        --disable-vdpau --disable-va --disable-omx --disable-opencl \
        --disable-gallium-tests
    make -j2
    make DESTDIR="$_stage" install
}

check() {
    cd "$srcdir/libdrm-2.4.89"
    export LD_LIBRARY_PATH="$_stage$_prefix/lib"
    _includes="-DHAVE_CONFIG_H -I. -Iinclude/drm -Ifreedreno -I$srcdir"
    _links="-L$_stage$_prefix/lib -ldrm_freedreno -ldrm -lpthread"
    for _test in test-kgsl-abi test-kgsl-map test-kgsl-timestamps; do
        $CC $CFLAGS -UNDEBUG -std=gnu11 -ffunction-sections -fdata-sections $_includes \
            "$srcdir/$_test.c" -Wl,--gc-sections $_links -o "$srcdir/$_test"
        "$srcdir/$_test"
    done
    $CC $CFLAGS -UNDEBUG -std=gnu11 $_includes \
        '-DDIOR_DRM_HEADER="kernel-kgsl-drm-uapi.h"' \
        "$srcdir/test-kgsl-abi.c" -o "$srcdir/test-kernel-kgsl-abi"
    "$srcdir/test-kgsl-abi" > "$srcdir/userspace-abi.txt"
    "$srcdir/test-kernel-kgsl-abi" > "$srcdir/kernel-abi.txt"
    cmp "$srcdir/userspace-abi.txt" "$srcdir/kernel-abi.txt"
    test -f "$_stage$_prefix/lib/dri/kgsl_dri.so"
    test -f "$_stage$_prefix/lib/libEGL.so.1"
    test -f "$_stage$_prefix/lib/libGLESv2.so.2"
    printf '%s\n' 'PASS target UAPI equality, ION mapping failure paths, context timestamps' \
        > "$srcdir/graphics-build-checks.txt"
}

package() {
    install -d "$pkgdir/opt"
    cp -a "$_stage$_prefix" "$pkgdir/opt/"
    install -Dm755 "$srcdir/dior-gles-check" "$pkgdir$_prefix/bin/dior-gles-check"
    install -Dm644 "$srcdir/dior-gles-probe.py" "$pkgdir$_prefix/libexec/dior-gles-probe.py"
    install -Dm644 "$srcdir/graphics-build-checks.txt" "$pkgdir$_prefix/share/graphics-build-checks.txt"
    # The package's runtime stays entirely in its isolated prefix.
    rm -f "$pkgdir$_prefix"/lib/*.la
    rm -rf "$pkgdir$_prefix/include" "$pkgdir$_prefix/lib/pkgconfig"
}

