# Maintainer Attila Szollosi <ata2001@airmail.cc>
pkgname=wcnss-wlan
pkgver=2
pkgrel=3
pkgdesc="Init script for enabling wcnss wlan driver (downstream Android kernels)"
url="https://gitlab.postmarketos.org/postmarketOS/pmaports"
arch="noarch"
license="GPL-3.0-or-later"
source="$pkgname.initd $pkgname.service"
subpackages="$pkgname-openrc"
options="!check" # No tests

package() {
	install -Dm755 "$srcdir"/$pkgname.initd "$pkgdir"/etc/init.d/wcnss-wlan
	install -Dm644 "$srcdir"/$pkgname.service "$pkgdir"/usr/lib/systemd/system/wcnss-wlan.service
	install -d "$pkgdir"/etc/systemd/system/multi-user.target.wants
	ln -sf /usr/lib/systemd/system/wcnss-wlan.service 		"$pkgdir"/etc/systemd/system/multi-user.target.wants/wcnss-wlan.service
}

openrc() {
	install="$subpkgname.post-install"
	default_openrc
}

sha512sums="
