Subject: [PATCH] ipc: retain one default subsystem reference per socket

Repeated LOOKUP_SERVER previously overwrote default_pil after another
subsystem_get, while close only put it once. Serialize bind with the
existing socket lock, reuse its handle, and validate lookup arguments
before starting the modem. This prevents leaks, not modem firmware crashes.

--- a/arch/arm/mach-msm/ipc_socket.c
+++ b/arch/arm/mach-msm/ipc_socket.c
@@ -304,7 +304,6 @@
 	struct sock *sk = sock->sk;
 	struct msm_ipc_port *port_ptr;
 	int ret;
-	void *pil;
 
 	if (!sk)
 		return -EINVAL;
@@ -334,9 +333,9 @@
 	if (!port_ptr)
 		return -ENODEV;
 
-	pil = msm_ipc_load_default_node();
-	msm_ipc_sk(sk)->default_pil = pil;
 	lock_sock(sk);
+	if (!msm_ipc_sk(sk)->default_pil)
+		msm_ipc_sk(sk)->default_pil = msm_ipc_load_default_node();
 
 	ret = msm_ipc_router_register_server(port_ptr, &addr->address);
 
@@ -450,7 +449,6 @@
 	unsigned int n;
 	size_t srv_info_sz = 0;
 	int ret;
-	void *pil;
 
 	if (!sk)
 		return -EINVAL;
@@ -478,8 +476,6 @@
 		break;
 
 	case IPC_ROUTER_IOCTL_LOOKUP_SERVER:
-		pil = msm_ipc_load_default_node();
-		msm_ipc_sk(sk)->default_pil = pil;
 		ret = copy_from_user(&server_arg, (void *)arg,
 				     sizeof(server_arg));
 		if (ret) {
@@ -508,6 +504,9 @@
 				break;
 			}
 		}
+		/* One subsystem reference belongs to this socket until close. */
+		if (!msm_ipc_sk(sk)->default_pil)
+			msm_ipc_sk(sk)->default_pil = msm_ipc_load_default_node();
 		ret = msm_ipc_router_lookup_server_name(&server_arg.port_name,
 				srv_info, server_arg.num_entries_in_array,
 				server_arg.lookup_mask);
