Subject: [PATCH] camera: propagate sensor init errors and interrupted waits

diff --git a/drivers/media/platform/msm/camera_v2/sensor/msm_sensor_init.c b/drivers/media/platform/msm/camera_v2/sensor/msm_sensor_init.c
index 4650df7d..e3f31119 100644
--- a/drivers/media/platform/msm/camera_v2/sensor/msm_sensor_init.c
+++ b/drivers/media/platform/msm/camera_v2/sensor/msm_sensor_init.c
@@ -47,22 +47,13 @@ static const struct v4l2_subdev_internal_ops msm_sensor_init_internal_ops;
 
 static int msm_sensor_wait_for_probe_done(struct msm_sensor_init_t *s_init)
 {
-	int rc;
-
 	if (s_init->module_init_status == 1) {
 		CDBG("msm_cam_get_module_init_status -2\n");
 		return 0;
 	}
 
-	while (1) {
-		rc = wait_event_interruptible(s_init->state_wait,
-			(s_init->module_init_status == 1));
-		if (rc == -ETIMEDOUT)
-			continue;
-		else if (rc == 0)
-			break;
-	}
-	return 0;
+	return wait_event_interruptible(s_init->state_wait,
+		(s_init->module_init_status == 1));
 }
 
 /* Static function definition */
@@ -93,11 +84,12 @@ static long msm_sensor_driver_cmd(struct msm_sensor_init_t *s_init, void *arg)
 		break;
 
 	case CFG_SINIT_PROBE_WAIT_DONE:
-		msm_sensor_wait_for_probe_done(s_init);
+		rc = msm_sensor_wait_for_probe_done(s_init);
 		break;
 
 	default:
 		pr_err("default");
+		rc = -EINVAL;
 		break;
 	}
 
@@ -124,10 +116,11 @@ static long msm_sensor_init_subdev_ioctl(struct v4l2_subdev *sd,
 
 	default:
 		pr_err("default");
+		rc = -ENOIOCTLCMD;
 		break;
 	}
 
-	return 0;
+	return rc;
 }
 
 static int __init msm_sensor_init_module(void)
