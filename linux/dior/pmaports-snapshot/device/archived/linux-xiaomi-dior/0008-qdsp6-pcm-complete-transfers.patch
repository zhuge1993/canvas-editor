+static void msm_pcm_copy_abort(struct msm_audio *prtd, int error)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&prtd->copy_state_lock, flags);
+	if (!prtd->abort || prtd->abort == -EPIPE)
+		prtd->abort = error;
+	atomic_set(&prtd->start, 0);
+	spin_unlock_irqrestore(&prtd->copy_state_lock, flags);
+	wake_up(&prtd->write_wait);
+	wake_up(&prtd->read_wait);
+}
+
+/* Serialize enqueue with abort so close cannot miss a late callback work item. */
+static void msm_pcm_schedule_tx(struct msm_audio *prtd)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&prtd->copy_state_lock, flags);
+	if (!prtd->abort || prtd->tx_eos_pending)
+		schedule_work(&prtd->tx_work);
+	spin_unlock_irqrestore(&prtd->copy_state_lock, flags);
+}
+
+/* Caller holds copy_state_lock. Publish only bytes already copied. */
+static void msm_pcm_publish_tx(struct msm_audio *prtd)
+{
+	if (!prtd->tx_data || !prtd->tx_filled || prtd->tx_copy_busy)
+		return;
+	prtd->tx_queued[prtd->tx_idx] = prtd->tx_filled;
+	atomic_inc(&prtd->out_needed);
+	prtd->tx_data = NULL;
+	prtd->tx_filled = 0;
+	prtd->tx_capacity = 0;
+}
+
+/* APR callbacks publish/schedule only; mutex/RPC execution stays here. */
+static void msm_pcm_tx_work(struct work_struct *work)
+{
+	struct msm_audio *prtd = container_of(work, struct msm_audio, tx_work);
+	unsigned long flags;
+	uint32_t idx, bytes;
+	int ret;
+	bool eos;
+
+	mutex_lock(&prtd->tx_lock);
+	for (;;) {
+		spin_lock_irqsave(&prtd->copy_state_lock, flags);
+		eos = prtd->tx_eos_pending;
+		if (eos) {
+			prtd->tx_eos_pending = false;
+			spin_unlock_irqrestore(&prtd->copy_state_lock, flags);
+			ret = q6asm_cmd_nowait(prtd->audio_client, CMD_EOS);
+			if (ret < 0) {
+				clear_bit(CMD_EOS, &prtd->cmd_pending);
+				wake_up(&prtd->eos_wait);
+			}
+			continue;
+		}
+		idx = prtd->tx_next;
+		if (prtd->abort || !atomic_read(&prtd->start) ||
+		    !prtd->tx_queued[idx]) {
+			spin_unlock_irqrestore(&prtd->copy_state_lock, flags);
+			break;
+		}
+		bytes = prtd->tx_queued[idx];
+		prtd->tx_queued[idx] = 0;
+		prtd->tx_submitted[idx] = bytes;
+		prtd->tx_next = (idx + 1) % prtd->periods;
+		atomic_dec(&prtd->out_needed);
+		spin_unlock_irqrestore(&prtd->copy_state_lock, flags);
+		ret = q6asm_write(prtd->audio_client, bytes, 0, 0, NO_TIMESTAMP);
+		if (ret < 0) {
+			msm_pcm_copy_abort(prtd, ret);
+			break;
+		}
+	}
+	mutex_unlock(&prtd->tx_lock);
+}
+
+static int msm_pcm_reset_copy_state(struct msm_audio *prtd)
+{
+	unsigned long flags;
+	int ret = 0;
+
+	msm_pcm_copy_abort(prtd, -EPIPE);
+	cancel_work_sync(&prtd->tx_work);
+	mutex_lock(&prtd->copy_lock);
+	if (prtd->enabled) {
+		ret = q6asm_cmd(prtd->audio_client, CMD_FLUSH);
+		if (ret < 0)
+			goto out;
+	}
+	spin_lock_irqsave(&prtd->copy_state_lock, flags);
+	memset(prtd->tx_queued, 0, sizeof(prtd->tx_queued));
+	memset(prtd->tx_submitted, 0, sizeof(prtd->tx_submitted));
+	memset(prtd->in_frame_info, 0, sizeof(prtd->in_frame_info));
+	prtd->tx_data = NULL;
+	prtd->tx_filled = prtd->tx_capacity = prtd->tx_next = 0;
+	prtd->tx_copy_busy = false;
+	prtd->tx_eos_pending = false;
+	prtd->rx_data = NULL;
+	prtd->rx_remaining = prtd->rx_offset = 0;
+	prtd->abort = 0;
+	atomic_set(&prtd->start, 0);
+	atomic_set(&prtd->out_needed, 0);
+	atomic_set(&prtd->in_count, 0);
+	spin_unlock_irqrestore(&prtd->copy_state_lock, flags);
+out:
+	mutex_unlock(&prtd->copy_lock);
+	return ret;
+}
