# Local image package. build-image.sh copies this aport into the active pmaports tree
# and runs "pmbootstrap checksum flowboard-server" before building.
pkgname=flowboard-server
pkgver=1.0.0
pkgrel=4
pkgdesc="FlowBoard always-on drawing server"
url="https://github.com/zhuge1993/canvas-editor"
arch="noarch"
# Owner's appliance deployment; repository visibility does not grant an OSS license.
license="custom"
depends="nodejs ca-certificates dropbear alsa-utils v4l-utils evtest bluez bluez-openrc gpsd flowboard-dior-firmware"
# Local appliance intentionally retains /opt/flowboard shared with its installers.
# abuild's documented !fhs permits this layout; all other postchecks still run.
# This is not a package intended for inclusion in Alpine's official repositories.
options="!check !fhs"
install="$pkgname.pre-install $pkgname.post-install"
backup="opt/flowboard/flowboard.env"
source="flowboard-release.tar.gz dior-dropbear.initd dior-firmware.initd dior-adsp.initd dior-bluetooth.initd dior-gps.initd dior-hw-report.initd dior-hw-probe dior-touch-test dior-hw-verify dior-hw-smoke"

package() {
	install -d "$pkgdir"/opt/flowboard
	install -Dm644 "$srcdir"/server-bundle.cjs "$pkgdir"/opt/flowboard/server-bundle.cjs
	cp -a "$srcdir"/dist "$pkgdir"/opt/flowboard/dist
	install -Dm755 "$srcdir"/start-server.sh "$pkgdir"/opt/flowboard/start-server.sh
	install -Dm644 "$srcdir"/healthcheck.cjs "$pkgdir"/opt/flowboard/healthcheck.cjs
	install -Dm600 "$srcdir"/flowboard.env.example "$pkgdir"/opt/flowboard/flowboard.env

	install -d -m 0750 "$pkgdir"/opt/flowboard/project-data
	install -d -m 0750 "$pkgdir"/opt/flowboard/auth-data
	install -d -m 0750 "$pkgdir"/opt/flowboard/logs

	# Ship both service-manager definitions. Only the selected init system uses its link.
	install -Dm755 "$srcdir"/flowboard.openrc "$pkgdir"/etc/init.d/flowboard
	install -Dm644 "$srcdir"/flowboard.service "$pkgdir"/usr/lib/systemd/system/flowboard.service
	install -Dm755 "$srcdir"/dior-dropbear.initd "$pkgdir"/etc/init.d/dior-dropbear
	install -Dm755 "$srcdir"/dior-firmware.initd "$pkgdir"/etc/init.d/dior-firmware
	install -Dm755 "$srcdir"/dior-adsp.initd "$pkgdir"/etc/init.d/dior-adsp
	install -Dm755 "$srcdir"/dior-bluetooth.initd "$pkgdir"/etc/init.d/dior-bluetooth
	install -Dm755 "$srcdir"/dior-gps.initd "$pkgdir"/etc/init.d/dior-gps
	install -Dm755 "$srcdir"/dior-hw-report.initd "$pkgdir"/etc/init.d/dior-hw-report
	install -Dm755 "$srcdir"/dior-hw-probe "$pkgdir"/usr/local/sbin/dior-hw-probe
	install -Dm755 "$srcdir"/dior-touch-test "$pkgdir"/usr/local/sbin/dior-touch-test
	install -Dm755 "$srcdir"/dior-hw-verify "$pkgdir"/usr/local/sbin/dior-hw-verify
	install -Dm755 "$srcdir"/dior-hw-smoke "$pkgdir"/usr/local/sbin/dior-hw-smoke

	install -d "$pkgdir"/etc/runlevels/default
	ln -sf /etc/init.d/flowboard "$pkgdir"/etc/runlevels/default/flowboard
	ln -sf /etc/init.d/dior-dropbear "$pkgdir"/etc/runlevels/default/dior-dropbear
	ln -sf /etc/init.d/dior-firmware "$pkgdir"/etc/runlevels/default/dior-firmware
	ln -sf /etc/init.d/dior-adsp "$pkgdir"/etc/runlevels/default/dior-adsp
	ln -sf /etc/init.d/dior-bluetooth "$pkgdir"/etc/runlevels/default/dior-bluetooth
	ln -sf /etc/init.d/dior-gps "$pkgdir"/etc/runlevels/default/dior-gps
	ln -sf /etc/init.d/dior-hw-report "$pkgdir"/etc/runlevels/default/dior-hw-report
	ln -sf /etc/init.d/bluetooth "$pkgdir"/etc/runlevels/default/bluetooth

	install -d "$pkgdir"/etc/systemd/system/multi-user.target.wants
	ln -sf /usr/lib/systemd/system/flowboard.service \
		"$pkgdir"/etc/systemd/system/multi-user.target.wants/flowboard.service
}

sha512sums=""
