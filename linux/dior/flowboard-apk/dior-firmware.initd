#!/sbin/openrc-run

description="Expose stock dior firmware partition to downstream Linux 3.4"

depend() {
	need localmount
	before wcnss-wlan dior-adsp networkmanager
}

find_modem_partition() {
	for p in \
		/dev/disk/by-partlabel/modem \
		/dev/block/bootdevice/by-name/modem \
		/dev/block/platform/msm_sdcc.1/by-name/modem \
		/dev/block/platform/msm_sdcc.1/by-name/firmware
	do
		[ -e "$p" ] && { printf '%s\n' "$p"; return 0; }
	done
	if command -v findfs >/dev/null 2>&1; then
		findfs PARTLABEL=modem 2>/dev/null && return 0
	fi
	return 1
}

link_firmware_family() {
	base="$1"
	for src in "$base"/adsp.* "$base"/mba.* "$base"/modem.* "$base"/venus.* "$base"/wcnss.*; do
		[ -f "$src" ] || continue
		name="$(basename "$src")"
		dst="/lib/firmware/$name"
		[ -e "$dst" ] || ln -s "$src" "$dst"
	done
}

is_mounted() {
	grep -qs " /run/dior-firmware " /proc/mounts
}

mirror_pmos_legacy_firmware() {
	# postmarketOS keeps archived-device firmware under its own namespace, but
	# dior's downstream 3.4 firmware loader cannot change firmware_class.path.
	# Copy real bytes (cp -L) into the legacy locations before PIL/WCNSS starts.
	for src in /lib/firmware/postmarketos/wcnss.*; do
		[ -f "$src" ] || continue
		dst="/lib/firmware/$(basename "$src")"
		cp -Lf "$src" "$dst"
		chmod 0644 "$dst" 2>/dev/null || true
	done

	if [ -d /lib/firmware/postmarketos/wlan/prima ]; then
		mkdir -p /lib/firmware/wlan/prima /etc/firmware/wlan/prima
		for src in /lib/firmware/postmarketos/wlan/prima/*; do
			[ -f "$src" ] || continue
			name="$(basename "$src")"
			cp -Lf "$src" "/lib/firmware/wlan/prima/$name"
			cp -Lf "$src" "/etc/firmware/wlan/prima/$name"
			chmod 0644 "/lib/firmware/wlan/prima/$name" "/etc/firmware/wlan/prima/$name" 2>/dev/null || true
		done
	fi
}

start() {
	ebegin "Preparing dior stock firmware bridge"
	mkdir -p /run/dior-firmware /lib/firmware
	mirror_pmos_legacy_firmware
	if ! is_mounted; then
		part="$(find_modem_partition 2>/dev/null || true)"
		if [ -n "$part" ]; then
			if ! mount -o ro "$part" /run/dior-firmware 2>/dev/null; then
				ewarn "Found firmware/modem partition but could not mount it read-only"
			fi
		else
			ewarn "No modem firmware partition alias found"
		fi
	fi

	if is_mounted; then
		link_firmware_family /run/dior-firmware
		link_firmware_family /run/dior-firmware/image
	fi

	if [ -s /lib/firmware/wcnss.mdt ]; then
		einfo "Legacy WCNSS firmware is available"
	else
		ewarn "Legacy WCNSS firmware is missing; Wi-Fi cannot start"
	fi

	if [ -s /lib/firmware/adsp.mdt ]; then
		einfo "ADSP firmware is available"
	else
		ewarn "ADSP firmware is not available yet; audio DSP cannot start"
	fi
	eend 0
}
