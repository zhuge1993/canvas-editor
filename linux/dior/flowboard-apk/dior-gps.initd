#!/sbin/openrc-run

description="Expose Xiaomi dior GPS NMEA SMD channel through gpsd"
pidfile="/run/dior-gps.pid"

depend() {
	need udev
	after dior-firmware
	before flowboard
}

start() {
	ebegin "Starting dior GPS NMEA bridge"
	tries=0
	while [ ! -c /dev/smd27 ] && [ "$tries" -lt 40 ]; do
		sleep 0.25
		tries=$((tries + 1))
	done
	if [ ! -c /dev/smd27 ]; then
		ewarn "GPS NMEA SMD channel /dev/smd27 is not available; gpsd skipped"
		eend 0
		return 0
	fi
	if [ ! -x /usr/sbin/gpsd ]; then
		eerror "gpsd is not installed"
		eend 1
		return 1
	fi
	start-stop-daemon --start --background --make-pidfile --pidfile "$pidfile" \
		--exec /usr/sbin/gpsd -- -N -n /dev/smd27
	eend $?
}

stop() {
	ebegin "Stopping dior GPS NMEA bridge"
	if [ -f "$pidfile" ]; then
		start-stop-daemon --stop --pidfile "$pidfile" --retry TERM/5/KILL/5 || true
		rm -f "$pidfile"
	fi
	eend 0
}
