#!/bin/sh
set -e

mkdir -p /opt/flowboard/project-data /opt/flowboard/auth-data /opt/flowboard/logs

# Program directory is root-owned but traversable by the service group.
# The service account can only write runtime config/data directories.
chown root:flowboard /opt/flowboard
chmod 0750 /opt/flowboard

chown flowboard:flowboard \
	/opt/flowboard/flowboard.env \
	/opt/flowboard/project-data \
	/opt/flowboard/auth-data \
	/opt/flowboard/logs
chmod 0600 /opt/flowboard/flowboard.env
chmod 0750 \
	/opt/flowboard/project-data \
	/opt/flowboard/auth-data \
	/opt/flowboard/logs

# Dior downstream kernel exposes GPS NMEA on fixed SMD tty index 27.
# Configure Alpine gpsd to consume it without printing or storing coordinates here.
if [ -f /etc/conf.d/gpsd ]; then
	if grep -q '^DEVICES=' /etc/conf.d/gpsd; then
		sed -i 's|^DEVICES=.*|DEVICES="/dev/smd27"|' /etc/conf.d/gpsd
	else
		printf '%s\n' 'DEVICES="/dev/smd27"' >> /etc/conf.d/gpsd
	fi
fi

exit 0
