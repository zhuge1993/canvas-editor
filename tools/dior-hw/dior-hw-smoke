#!/bin/sh
# Non-destructive active hardware smoke test for Xiaomi Redmi Note 4G (dior).
# Does not print Wi-Fi credentials, GPS coordinates, authentication files or user data.
set -u

section(){ printf "\n===== %s =====\n" "$1"; }
run(){ printf '+ %s\n' "$*"; "$@" 2>&1 || true; }

section "BASELINE"
if command -v dior-hw-verify >/dev/null 2>&1; then
	dior-hw-verify || true
else
	echo "dior-hw-verify missing"
fi

section "WIFI ACTIVE"
if [ -d /sys/class/net/wlan0 ]; then
	run ip link set wlan0 up
	if command -v nmcli >/dev/null 2>&1; then
		run nmcli device status
		# Show SSID names only as a radio smoke test; never print stored secrets.
		run nmcli -f IN-USE,SSID,SIGNAL,SECURITY device wifi list --rescan yes
	else
		echo "nmcli unavailable; wlan0 exists"
	fi
else
	echo "wlan0 missing"
fi

section "AUDIO ENUMERATION"
command -v aplay >/dev/null 2>&1 && run aplay -l
command -v arecord >/dev/null 2>&1 && run arecord -l
safe_cards="$(cat /proc/asound/cards 2>/dev/null || true)"
printf '%s\n' "$safe_cards"

section "CAMERA / VIDEO ENUMERATION"
if command -v v4l2-ctl >/dev/null 2>&1; then
	run v4l2-ctl --list-devices
	for dev in /dev/video0 /dev/video32 /dev/video33 /dev/video34 /dev/video35; do
		[ -c "$dev" ] || continue
		echo "--- $dev ---"
		timeout 5 v4l2-ctl -d "$dev" --all 2>&1 | head -n 120 || true
	done
else
	echo "v4l2-ctl unavailable"
fi

section "BLUETOOTH"
if [ -d /sys/class/bluetooth/hci0 ]; then
	echo "hci0 registered"
	command -v hciconfig >/dev/null 2>&1 && run hciconfig hci0 up
	command -v hciconfig >/dev/null 2>&1 && run hciconfig -a
	command -v bluetoothctl >/dev/null 2>&1 && run bluetoothctl show
else
	echo "hci0 missing"
fi

section "GPS / NMEA BYTE TEST"
# Do not print NMEA content because it can contain precise coordinates.
if [ -e /dev/smd27 ]; then
	tmp="/tmp/dior-gps-bytes.$$"
	timeout 5 cat /dev/smd27 > "$tmp" 2>/dev/null || true
	bytes="$(wc -c < "$tmp" 2>/dev/null | tr -d ' ' || echo 0)"
	rm -f "$tmp"
	printf 'GPSNMEA /dev/smd27 produced %s bytes in <=5s\n' "$bytes"
else
	echo "/dev/smd27 missing"
fi

section "MODEM / RMNET"
for n in /sys/class/net/rmnet* /sys/class/net/rev_rmnet*; do
	[ -e "$n" ] || continue
	printf '%s operstate=%s carrier=%s\n' "$(basename "$n")" \
		"$(cat "$n/operstate" 2>/dev/null || true)" \
		"$(cat "$n/carrier" 2>/dev/null || true)"
done
ls -l /dev/smd* /dev/qcqmi* /dev/diag 2>/dev/null || true

section "POWER / CHARGING"
for p in /sys/class/power_supply/*; do
	[ -d "$p" ] || continue
	printf '%s type=%s status=%s online=%s capacity=%s voltage_now=%s current_now=%s temp=%s\n' \
		"$(basename "$p")" \
		"$(cat "$p/type" 2>/dev/null || true)" \
		"$(cat "$p/status" 2>/dev/null || true)" \
		"$(cat "$p/online" 2>/dev/null || true)" \
		"$(cat "$p/capacity" 2>/dev/null || true)" \
		"$(cat "$p/voltage_now" 2>/dev/null || true)" \
		"$(cat "$p/current_now" 2>/dev/null || true)" \
		"$(cat "$p/temp" 2>/dev/null || true)"
done

section "STORAGE / MICROSD / USB HOST"
command -v lsblk >/dev/null 2>&1 && run lsblk -o NAME,TYPE,SIZE,FSTYPE,MOUNTPOINT
for b in /sys/class/block/mmcblk*; do
	[ -e "$b" ] || continue
	printf '%s removable=%s size_sectors=%s\n' "$(basename "$b")" \
		"$(cat "$b/removable" 2>/dev/null || true)" "$(cat "$b/size" 2>/dev/null || true)"
done
find /sys/bus/usb/devices -maxdepth 2 -type f -name product -print -exec cat {} \; 2>/dev/null || true

section "SENSORS / HAPTIC / FM"
find /sys/class/sensors -maxdepth 2 -type f -name name -print -exec cat {} \; 2>/dev/null || true
[ -c /dev/tspdrv ] && echo "/dev/tspdrv present"
[ -e /sys/class/timed_output/vibrator/enable ] && echo "timed_output vibrator present"
ls -l /dev/radio* 2>/dev/null || true

section "DONE"
echo "Smoke test finished. No destructive writes were performed."
echo "For full logs also run: dior-hw-probe"
