#!/bin/sh
# One-shot post-flash hardware verification for Xiaomi dior.
set -u

pass=0
fail=0
info=0
ok(){ printf 'PASS  %s\n' "$*"; pass=$((pass+1)); }
bad(){ printf 'FAIL  %s\n' "$*"; fail=$((fail+1)); }
note(){ printf 'INFO  %s\n' "$*"; info=$((info+1)); }

[ -c /dev/fb0 ] && ok "display framebuffer /dev/fb0" || bad "display framebuffer missing"

touch_name=""
for e in /sys/class/input/event*; do
	[ -r "$e/device/name" ] || continue
	n="$(cat "$e/device/name")"
	case "$n" in
		*atmel*|*maxtouch*) touch_name="$n"; break ;;
	esac
done
[ -n "$touch_name" ] && ok "touchscreen: $touch_name" || bad "Atmel maXTouch input not registered"

[ -d /sys/class/net/usb0 ] && ok "USB NCM network usb0" || bad "USB network usb0 missing"
[ -c /dev/wcnss_wlan ] && ok "WCNSS control device" || bad "WCNSS control device missing"
[ -d /sys/class/net/wlan0 ] && ok "Wi-Fi wlan0 registered" || bad "Wi-Fi wlan0 not registered"

if [ -r /sys/kernel/audio_voice_service/status ]; then
	st="$(cat /sys/kernel/audio_voice_service/status)"
	[ "$st" = "ONLINE" ] && ok "Q6/ADSP ONLINE" || bad "Q6/ADSP status: $st"
else
	bad "Q6/ADSP status node missing"
fi
if [ -r /proc/asound/cards ] && ! grep -q 'no soundcards' /proc/asound/cards; then
	ok "ALSA sound card registered"
else
	bad "ALSA sound card not registered"
fi

[ -c /dev/media0 ] && ok "camera media controller /dev/media0" || bad "camera media controller missing"
if ls /dev/video* >/dev/null 2>&1; then ok "camera/video nodes present"; else bad "camera/video nodes missing"; fi
if dmesg 2>/dev/null | tail -n 600 | grep -q 'Failed to load video firmware'; then
	bad "VIDC still reports video firmware load failure"
else
	ok "no recent VIDC firmware-load failure"
fi

battery=""
for p in /sys/class/power_supply/*; do
	[ -r "$p/type" ] || continue
	[ "$(cat "$p/type" 2>/dev/null)" = "Battery" ] && { battery="$p"; break; }
done
if [ -n "$battery" ]; then
	cap="$(cat "$battery/capacity" 2>/dev/null || true)"
	if [ -n "$cap" ]; then ok "battery power_supply present, capacity=$cap%"; else ok "battery power_supply present"; fi
else
	bad "battery power_supply missing"
fi

charger_found=0
for p in /sys/class/power_supply/*; do
	[ -r "$p/type" ] || continue
	case "$(cat "$p/type" 2>/dev/null)" in
		USB|Mains)
			charger_found=1
			note "charger supply $(basename "$p") online=$(cat "$p/online" 2>/dev/null || echo '?')"
			;;
	esac
done
[ "$charger_found" -eq 1 ] && ok "charger power_supply present" || bad "charger power_supply missing"

if ls /sys/class/backlight/*/brightness >/dev/null 2>&1; then ok "backlight control present"; else bad "backlight control missing"; fi
if [ -e /sys/class/timed_output/vibrator ] || ls /sys/class/leds/*vib* >/dev/null 2>&1; then ok "vibrator control present"; else note "vibrator control not exposed"; fi

if [ -d /sys/class/bluetooth/hci0 ]; then ok "Bluetooth HCI controller hci0"; else note "Bluetooth HCI controller not registered"; fi

sensor_hits=0
for p in /sys/class/input/event*/device/name /sys/class/sensors/*/name; do
	[ -r "$p" ] || continue
	n="$(cat "$p" 2>/dev/null || true)"
	case "$n" in
		*accel*|*gyro*|*mag*|*compass*|*proximity*|*light*|*akm*|*sensor*)
			note "sensor: $n"
			sensor_hits=$((sensor_hits+1))
			;;
	esac
done
[ "$sensor_hits" -gt 0 ] && ok "sensor interfaces discovered" || note "no named sensor interfaces discovered"

if command -v rc-service >/dev/null 2>&1; then
	for s in dior-firmware dior-adsp wcnss-wlan flowboard; do
		rc-service "$s" status >/dev/null 2>&1 && ok "service $s running" || bad "service $s not running"
	done
fi

printf '\nSUMMARY pass=%d fail=%d info=%d\n' "$pass" "$fail" "$info"
printf 'Run dior-hw-probe as well when any FAIL remains.\n'
[ "$fail" -eq 0 ]
