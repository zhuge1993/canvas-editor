#!/bin/sh
# Read-only hardware probe for Xiaomi dior. Never prints authentication files.
set -u
section() { printf "\n===== %s =====\n" "$1"; }
safe_cat() { [ -r "$1" ] && cat "$1" || true; }

section "IDENTITY"
uname -a
printf "cmdline: "; safe_cat /proc/cmdline

section "DISPLAY"
for f in /sys/class/graphics/fb*/name /sys/class/graphics/fb*/virtual_size /sys/class/graphics/fb*/bits_per_pixel; do
  [ -r "$f" ] && printf "%s: %s\n" "$f" "$(cat "$f")"
done
ls -l /dev/fb* 2>/dev/null || true

section "INPUT / TOUCH"
safe_cat /proc/bus/input/devices
for e in /sys/class/input/event*; do
  [ -e "$e" ] || continue
  name="$(cat "$e/device/name" 2>/dev/null || true)"
  printf "%s -> %s\n" "$(basename "$e")" "$name"
done
ls -l /dev/input 2>/dev/null || true

section "WIFI / WCNSS"
ls -l /dev/wcnss_wlan 2>/dev/null || true
printf "fwpath: "; safe_cat /sys/module/wlan/parameters/fwpath
find /lib/firmware/postmarketos -maxdepth 3 -type f 2>/dev/null | grep -Ei "wcnss|prima|wlan" | sort || true
ip -details link show 2>/dev/null || ip link 2>/dev/null || true
command -v nmcli >/dev/null 2>&1 && nmcli device status || true

section "AUDIO / MICROPHONE"
safe_cat /proc/asound/cards
safe_cat /proc/asound/pcm
ls -l /dev/snd 2>/dev/null || true
for c in /sys/class/sound/card*/id; do [ -r "$c" ] && printf "%s: %s\n" "$c" "$(cat "$c")"; done

section "CAMERA / V4L2"
ls -l /dev/video* /dev/media* /dev/v4l-subdev* 2>/dev/null || true
for v in /sys/class/video4linux/*/name; do [ -r "$v" ] && printf "%s: %s\n" "$v" "$(cat "$v")"; done

section "RELEVANT KERNEL LOG"
dmesg 2>/dev/null | grep -Ei "touch|synapt|ft5|goodix|ist30|atmel|mxt|wcnss|pronto|wlan|wifi|firmware|wcd|audio|alsa|snd|camera|msm_cam|msmb|v4l|video[0-9]|cci|csid|csiphy" | tail -n 500 || true

section "SERVICES"
command -v rc-status >/dev/null 2>&1 && rc-status -a || true

section "DONE"
echo "Probe is read-only. Send this output back before changing drivers."
