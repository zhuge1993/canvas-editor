{
  "scripts": {
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:check": "npm --prefix frontend run check",
    "backend:dev": "granian --interface asgi backend.app.main:app --host 127.0.0.1 --port 9090 --reload",
    "test:backend": "python -m pytest backend/tests -q",
    "test:contract": "python -m pytest backend/tests -q -k contract",
    "test:e2e": "npm --prefix frontend run test:e2e",
    "test:e2e:perf": "npm --prefix frontend run test:e2e:perf",
    "test:perf": "python scripts/run_performance_tests.py"
  }
}
