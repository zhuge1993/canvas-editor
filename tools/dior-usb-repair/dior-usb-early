#!/bin/sh
# Dior's pinned 3.4 kernel uses android_usb, not configfs or g_ether.
# Run from inittab before OpenRC; never write any disk partition here.
set -u
B=/bin/busybox
A=/sys/class/android_usb/android0
LOG=/dev/dior-usb-early.log
log() { printf '%s\n' "dior-usb: $*" >> "$LOG" 2>/dev/null || :; }
put() { printf '%s\n' "$2" > "$A/$1"; }
log 'entered real rootfs; configuring authenticated USB access'
count=0
while [ ! -e "$A/enable" ] && [ "$count" -lt 20 ]; do
    $B sleep 1; count=$((count + 1))
done
if [ ! -e "$A/enable" ]; then log 'android_usb absent; leaving existing USB untouched'; exit 1; fi
if [ ! -e "$A/f_acm/acm_transports" ]; then log 'ACM tty transport absent; leaving USB untouched'; exit 1; fi
put enable 0 || exit 1
# Descriptor integer formats in this driver: IDs hex, class/subclass/protocol decimal.
put idVendor 18d1 && put idProduct d002 && put bcdDevice 0101 || exit 1
put bDeviceClass 239 && put bDeviceSubClass 2 && put bDeviceProtocol 1 || exit 1
put iManufacturer DiorLinux && put iProduct DiorLinux-NCM-ACM || exit 1
# Prefer the bootloader serial; otherwise retain the current value, never invent a hardware ID.
serial=$($B sed -n 's/.*androidboot.serialno=\([^ ]*\).*/\1/p' /proc/cmdline)
case "$serial" in ''|*[!A-Za-z0-9._-]*) ;; *) put iSerial "$serial" || : ;; esac
put f_acm/acm_transports tty || exit 1
selected=''
for mode in ncm rndis acm; do
    put enable 0 || break
    if [ "$mode" = acm ]; then funcs=acm
    else
        [ -d "$A/f_$mode" ] || continue
        funcs="$mode,acm"
    fi
    if [ "$mode" = rndis ] && [ -e "$A/f_rndis/wceis" ]; then
        put f_rndis/wceis 1 || continue
        put idProduct d003 || continue
        put iProduct DiorLinux-RNDIS-ACM || continue
    fi
    if [ "$mode" = acm ]; then
        put idProduct d004 || continue
        put iProduct DiorLinux-ACM-Recovery || continue
    fi
    put functions "$funcs" || continue
    # This old kernel sometimes reports successful sysfs writes even if binding failed.
    [ "$($B cat "$A/functions")" = "$funcs" ] || continue
    put enable 1 || continue
    [ "$($B cat "$A/enable")" = 1 ] || continue
    selected="$mode"; break
done
if [ -z "$selected" ]; then log 'all gadget compositions failed; check physical display'; exit 1; fi
log "enabled $selected with ACM; this is NOT host-enumeration validation"
# Create a console node from the kernel's actual major/minor when udev is not running yet.
count=0
while [ ! -e /sys/class/tty/ttyGS0/dev ] && [ "$count" -lt 10 ]; do
    $B sleep 1; count=$((count + 1))
done
if [ -e /sys/class/tty/ttyGS0/dev ] && [ ! -c /dev/ttyGS0 ]; then
    dev=$($B cat /sys/class/tty/ttyGS0/dev)
    major=${dev%:*}; minor=${dev#*:}
    case "$major:$minor" in *[!0-9:]*|:|*:*:*) log 'invalid ttyGS0 device numbers' ;;
        *) $B mknod /dev/ttyGS0 c "$major" "$minor" && $B chmod 600 /dev/ttyGS0 ;;
    esac
fi
# A password-required getty is independent of OpenRC/network startup, not an auto-root shell.
if [ -c /dev/ttyGS0 ] && $B mkdir /dev/.dior-usb-console-lock 2>/dev/null; then
    $B setsid /usr/local/sbin/dior-usb-console </dev/null >>/dev/dior-usb-console.log 2>&1 &
fi
[ "$selected" != acm ] || { log 'ACM-only fallback; diagnose using the COM port'; exit 0; }
iface="${selected}0"
count=0
while [ ! -d "/sys/class/net/$iface" ] && [ "$count" -lt 10 ]; do
    $B sleep 1; count=$((count + 1))
done
if [ ! -d "/sys/class/net/$iface" ]; then log 'network interface absent; ACM remains enabled'; exit 1; fi
# Keep the existing USB-only firewall/DHCP configuration usable by naming the actual interface usb0.
$B ip link set dev "$iface" down || exit 1
if [ -e /sys/class/net/usb0 ]; then log 'usb0 already occupied; refusing to rename another interface'; exit 1; fi
$B ip link set dev "$iface" name usb0 || exit 1
$B ip addr add 172.16.42.1/24 dev usb0 || exit 1
$B ip link set dev usb0 up || exit 1
log 'usb0 configured at 172.16.42.1/24; DHCP is supplied by the existing OpenRC service'
